# ---- Secrets ----
.env
*.key

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# ---- MorphAgent runtime outputs / caches ----
# Not "results/" itself: that would also hide the intentionally bundled
# MorphAgent_UI/MorphAgent/demo/data/results/completed_demo_run/ demo output.
run_*/
*.log
!MorphAgent_UI/MorphAgent/demo/data/results/completed_demo_run/ui_console.log
.rag_cache/
.morphagent_repro_cache/

# ---- User data (do NOT commit datasets) ----
# Anchored to repo root only, so bundled demo data (demo/data/,
# MorphAgent_UI/MorphAgent/demo/data/) is still tracked.
/data/
/datasets/

# ---- Segmentation / model artifacts ----
*.tif.out/
allen_seg_output/
allen_mito_output/
segmentation_results/
test_output/

# ---- OS / editor ----
.DS_Store
.vscode/
.idea/
