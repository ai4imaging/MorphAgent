# ---- Secrets ----
.env
*.key
MorphAgent_UI/.env

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# ---- MorphAgent runtime outputs / caches ----
# Not "results/" itself: that would also hide the intentionally bundled
# MorphAgent_UI/demo/data/results/completed_demo_run/ demo output.
run_*/
reuse_ui_*/
*.log
!MorphAgent_UI/demo/data/results/completed_demo_run/ui_console.log
.rag_cache/
.morphagent_repro_cache/
MorphAgent_UI/.rag_cache/

# ---- User data (do NOT commit datasets) ----
# Anchored to repo root only, so bundled UI demo data
# (MorphAgent_UI/demo/data/) is still tracked.
/data/
/datasets/
/demo/
MorphAgent_UI/.web_workspace/
MorphAgent_UI/logs/
MorphAgent_UI/manuscript/

# ---- Segmentation / model artifacts ----
*.tif.out/
allen_seg_output/
allen_mito_output/
segmentation_results/
test_output/

# ---- OS / editor ----
.DS_Store
.vscode/
.idea/

# ---- Local isolated development worktrees ----
.worktrees/

# ---- Local demo media (do not commit / push) ----
# The UI demo is served from GitHub user-attachments so that cloning the repo
# does not drag the video along; only the README link points at it.
/Supplementary_Video.mp4
/demo.mp4
/demo_.mp4
/demo_.srt
/media/

# ---- Local maintenance helper (not part of the release) ----
/scripts/
