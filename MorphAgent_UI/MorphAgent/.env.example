# ============================================================================
# MorphAgent configuration — copy this file to `.env` and fill in your values.
#   cp .env.example .env
# Then either `source .env` before running, or export these variables in your
# shell. (You can also just edit the USER CONFIGURATION block in config.py.)
#
# NOTE: MorphAgent (public build) talks to every model via an OpenAI-compatible
# HTTP API. There is NO local model in this build. Any provider that implements
# the OpenAI Chat Completions API works: OpenAI, Azure OpenAI, DeepSeek,
# Together, OpenRouter, or a self-hosted gateway (vLLM / Ollama / LM Studio).
# ============================================================================

# ---- LLM: the "brain" (plans features, writes/fixes code, reviews) ----------
# You MUST specify the model name explicitly.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-llm-key-here
LLM_MODEL=gpt-4o

# ---- VLM: the multimodal "eyes" (scores visual features from images) --------
# Must be a MULTIMODAL (vision) model. If you omit these, MorphAgent falls back
# to the LLM_* values above, so set VLM_MODEL to a vision-capable model.
VLM_BASE_URL=https://api.openai.com/v1
VLM_API_KEY=sk-your-vlm-key-here
VLM_MODEL=gpt-4o

# ---- Deep Research model (auto report, single API call) --------------------
# Used by --auto-deep-research to write a literature-grounded report in ONE call.
# Point it at a web-search / research-capable model for best results (e.g.
# Perplexity sonar / sonar-deep-research, OpenAI gpt-4o-search-preview). If you
# leave these unset it falls back to the LLM_* values above.
# DEEP_RESEARCH_BASE_URL=https://api.perplexity.ai
# DEEP_RESEARCH_API_KEY=pplx-your-key-here
# DEEP_RESEARCH_MODEL=sonar-deep-research

# ---- Literature retrieval (PubMed / Europe PMC) ----------------------------
# Used by --auto-literature-retrieval to download open-access PDFs into RAG/.
# No key required; an email (and optional free NCBI key) raises rate limits.
# NCBI_EMAIL=you@example.org
# NCBI_API_KEY=
# PUBMED_MAX_RESULTS=8
# PUBMED_MIN_YEAR=0

# ---- Conda environments -----------------------------------------------------
# Sandbox env that EXECUTES agent-generated feature code.
CONDA_ENV=morphagent
# Env that has Cellpose-SAM installed (auto segmentation). In the unified setup
# this is the same as CONDA_ENV.
SEGMENTATION_CONDA_ENV=morphagent
# Optional: explicit conda install root if auto-detection fails.
# CONDA_BASE=/home/you/miniconda3

# ---- PaddleX device for parsing PDF literature (RAG / Deep Research) --------
# PaddleX (CPU) is installed by the unified environment and is used to parse PDFs
# for RAG and deep-research. Default is "cpu"; set "gpu:0" if you installed
# paddlepaddle-gpu. Text/markdown reports are read directly without PaddleX.
# PADDLEX_DEVICE=cpu
