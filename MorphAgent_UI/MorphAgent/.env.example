# MorphAgent model endpoints (OpenAI Chat Completions compatible)
# The desktop UI can create/update .env from Configure > Model API. For CLI
# use, copy this file to .env and fill in the values manually.

# Planning, code generation/repair, and review
export LLM_BASE_URL="https://api.gpugeek.com/v1"
export LLM_API_KEY=""
export LLM_MODEL="Vendor2/GPT-4o"

# Keep these at or below the provider/model output-token limit. The teacher
# reference demo was verified against a GPT-4o-compatible gateway at 16384.
export LLM_MAX_TOKENS="16384"
export MERGE_MAX_TOKENS="16384"

# Image scoring. Reuse the same endpoint, key, and model unless your VLM differs.
export VLM_BASE_URL="${LLM_BASE_URL}"
export VLM_API_KEY="${LLM_API_KEY}"
export VLM_MODEL="${LLM_MODEL}"

# Unified environment used by generated code and Cellpose-SAM
export CONDA_ENV="morphagent"
export SEGMENTATION_CONDA_ENV="morphagent"

# Low-frequency run defaults for custom datasets. The bundled teacher demo
# remains fixed at 2 rounds x 5 candidates, target 10 for reproducibility.
export FEATURES_PER_ITERATION="5"
export TARGET_FEATURE_COUNT="10"
export NUM_ROUNDS="2"
export CODE_VLM_RATIO="0.5"
export KNOWLEDGE_DEPENDENCY="0.5"
export CODE_PARALLEL_WORKERS="1"
export VLM_ONLINE_CONCURRENCY="1"

# Optional timeout tuning
# export VLM_ONLINE_REQUEST_TIMEOUT="150"
# export CODE_EXECUTION_TIMEOUT="300"
