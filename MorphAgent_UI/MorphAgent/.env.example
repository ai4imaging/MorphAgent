# MorphAgent model endpoints (OpenAI Chat Completions compatible)
# The desktop UI can create/update .env from Configure > Model API. For CLI
# use, copy this file to .env and fill in the values manually.
#
# dotenv-compatible KEY=value form (also works with `export KEY=...` / `source .env`).

# Planning, code generation/repair, and review
# Leave blank here; fill in the UI (applied on Run) or set for CLI use.
# Example gateway previously verified: https://api.gpugeek.com/v1 · Vendor2/GPT-4o
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Keep these at or below the provider/model output-token limit. The teacher
# reference demo was verified against a GPT-4o-compatible gateway at 16384.
LLM_MAX_TOKENS=16384
MERGE_MAX_TOKENS=16384

# Image scoring. Reuse the same endpoint, key, and model unless your VLM differs.
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=

# ---- Deep Research model (auto report, single API call) --------------------
# Used by --auto-deep-research to write a literature-grounded report in ONE call.
# Point it at a web-search / research-capable model for best results (e.g.
# Perplexity sonar / sonar-deep-research, OpenAI gpt-4o-search-preview). If you
# leave these unset it falls back to the LLM_* values above.
# DEEP_RESEARCH_BASE_URL=https://api.perplexity.ai
# DEEP_RESEARCH_API_KEY=pplx-your-key-here
# DEEP_RESEARCH_MODEL=sonar-deep-research

# ---- Literature retrieval (PubMed / Europe PMC) ----------------------------
# Used by --auto-literature-retrieval to download open-access PDFs into RAG/.
# No key required; an email (and optional free NCBI key) raises rate limits.
# NCBI_EMAIL=you@example.org
# NCBI_API_KEY=
# PUBMED_MAX_RESULTS=8
# PUBMED_MIN_YEAR=0

# Unified environment used by generated code and Cellpose-SAM
CONDA_ENV=morphagent
SEGMENTATION_BACKEND=allen
SEGMENTATION_CONDA_ENV=morphagent_allen
# Optional: explicit conda install root if auto-detection fails.
# CONDA_BASE=/home/you/miniconda3

# Low-frequency run defaults for custom datasets. The bundled teacher demo
# remains fixed at 2 rounds x 5 candidates, target 10 for reproducibility.
FEATURES_PER_ITERATION=5
TARGET_FEATURE_COUNT=10
NUM_ROUNDS=1
CODE_VLM_RATIO=0.5
KNOWLEDGE_DEPENDENCY=0.5
CODE_PARALLEL_WORKERS=1
VLM_ONLINE_CONCURRENCY=1

# Optional timeout tuning
# VLM_ONLINE_REQUEST_TIMEOUT=150
# CODE_EXECUTION_TIMEOUT=300

# ---- PaddleX device for parsing PDF literature (RAG / Deep Research) --------
# PaddleX (CPU) is installed by the unified environment and is used to parse PDFs
# for RAG and deep-research. Default is "cpu"; set "gpu:0" if you installed
# paddlepaddle-gpu. Text/markdown reports are read directly without PaddleX.
# PADDLEX_DEVICE=cpu
#
# Model download source for PaddleX official weights (huggingface | modelscope | bos | aistudio).
# If HuggingFace hangs or is blocked, use Baidu BOS:
# PADDLE_PDX_MODEL_SOURCE=bos
